@using System.Net.Http.Headers
@using System.Net.Http.Json
@using GestionInterventions.Web.Authentication
@implements IDisposable
@using GestionInterventions.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IHttpClientFactory HttpClientFactory
@inject TokenProvider TokenProvider
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationHubService NotificationHubService
@inject TechnicienNotificationStateService TechnicienNotificationStateService
@inject ResponsableNotificationStateService ResponsableNotificationStateService
@inject ResponsableValidationNotificationStateService ResponsableValidationNotificationStateService

<nav class="flex-column py-2">
    <div class="nav-item">
        <NavLink class="nav-link" href="accueil" Match="NavLinkMatch.All">Accueil</NavLink>
    </div>

    <AuthorizeView Roles="Client">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="mes-equipements">Mes équipements</NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="mes-demandes">Mes demandes</NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Technicien">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link intervention-link" href="mes-interventions"
                         @onclick='() => MarquerNotificationsCommeLues("NouvelleIntervention")'>
                    <span>Mes interventions</span>
                    @if (TechnicienNotificationStateService.HasUnreadNouvelleIntervention)
                    {
                        <span class="notification-badge"
                              aria-label="@($"{_unreadNotificationCount} notifications non lues")">
                            @_unreadNotificationCount
                        </span>
                    }
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Responsable">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link intervention-link" href="demandes"
                         @onclick='() => MarquerNotificationsCommeLues("NouvelleDemande")'>
                    <span>Demandes d'intervention</span>
                    @if (_unreadDemandeNotificationCount > 0)
                    {
                        <span class="notification-badge"
                              aria-label="@($"{_unreadDemandeNotificationCount} notifications non lues")">
                            @_unreadDemandeNotificationCount
                        </span>
                    }
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link intervention-link" href="interventions-a-valider"
                         @onclick='() => MarquerNotificationsCommeLues("InterventionTerminee")'>
                    <span>Interventions à valider</span>
                    @if (_unreadValidationNotificationCount > 0)
                    {
                        <span class="notification-badge"
                              aria-label="@($"{_unreadValidationNotificationCount} notifications non lues")">
                            @_unreadValidationNotificationCount
                        </span>
                    }
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="toutes-interventions">Toutes les interventions</NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="techniciens">Techniciens</NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="clients">Clients</NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="historique-equipement">Historique équipement</NavLink>
            </div>
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    private int _unreadNotificationCount;
    private int _unreadDemandeNotificationCount;
    private int _unreadValidationNotificationCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            TechnicienNotificationStateService.OnStateChanged += HandleNotificationStateChanged;
            ResponsableNotificationStateService.OnStateChanged += HandleNotificationStateChanged;
            ResponsableValidationNotificationStateService.OnStateChanged += HandleNotificationStateChanged;
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        if ((user.IsInRole("Technicien") || user.IsInRole("Responsable"))
            && !NotificationHubService.IsConnected)
        {
            await NotificationHubService.StartAsync();
        }

        if (firstRender)
        {
            await ChargerNotificationsNonLues();

            StateHasChanged();
        }
    }

    public void Dispose()
    {
        TechnicienNotificationStateService.OnStateChanged -= HandleNotificationStateChanged;
        ResponsableNotificationStateService.OnStateChanged -= HandleNotificationStateChanged;
        ResponsableValidationNotificationStateService.OnStateChanged -= HandleNotificationStateChanged;
    }

    private void HandleNotificationStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            _unreadNotificationCount = TechnicienNotificationStateService.HasUnreadNouvelleIntervention
                ? TechnicienNotificationStateService.NewInterventionIds.Count
                : 0;
            _unreadDemandeNotificationCount = ResponsableNotificationStateService.HasUnreadNouvelleDemande
                ? ResponsableNotificationStateService.NouvelleDemandeIds.Count
                : 0;
            _unreadValidationNotificationCount = ResponsableValidationNotificationStateService.HasUnreadInterventionTerminee
                ? ResponsableValidationNotificationStateService.InterventionIds.Count
                : 0;
            StateHasChanged();
        });
    }

    private async Task ChargerNotificationsNonLues()
    {
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authenticationState.User;

            if (!user.IsInRole("Technicien") && !user.IsInRole("Responsable"))
                return;

            await TokenProvider.LoadTokenAsync();

            if (string.IsNullOrWhiteSpace(TokenProvider.Token))
                return;

            var client = HttpClientFactory.CreateClient("Api");

            client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.GetAsync("api/Notifications/unread");

            if (!response.IsSuccessStatusCode)
                return;

            var notifications =
                await response.Content.ReadFromJsonAsync<List<NotificationDto>>();

            if (user.IsInRole("Technicien"))
            {
                var nouvellesInterventions = notifications?
                    .Where(n => n.Type == "NouvelleIntervention" && n.InterventionId.HasValue)
                    .ToList()
                    ?? new();

                _unreadNotificationCount = nouvellesInterventions.Count;
                TechnicienNotificationStateService.SetNewInterventionIds(
                    nouvellesInterventions.Select(n => n.InterventionId!.Value));

                TechnicienNotificationStateService.SetUnreadState(_unreadNotificationCount > 0);
            }
            else if (user.IsInRole("Responsable"))
            {
                var nouvelleDemandeNotifications =
                    notifications?
                        .Where(n => n.Type == "NouvelleDemande" && n.DemandeId.HasValue)
                        .ToList()
                    ?? new();

                var interventionTermineeNotifications =
                    notifications?
                        .Where(n => n.Type == "InterventionTerminee" && n.InterventionId.HasValue)
                        .ToList()
                    ?? new();

                _unreadDemandeNotificationCount = nouvelleDemandeNotifications.Count;
                _unreadValidationNotificationCount = interventionTermineeNotifications.Count;

                ResponsableNotificationStateService.SetNouvelleDemandeNotifications(nouvelleDemandeNotifications.Select(n =>
n.DemandeId!.Value));
                ResponsableValidationNotificationStateService.SetInterventionTermineeNotifications(interventionTermineeNotifications.Select(n
=> n.InterventionId!.Value));
            }
        }
        catch (Exception)
        {
            _unreadNotificationCount = 0;
            _unreadDemandeNotificationCount = 0;
            _unreadValidationNotificationCount = 0;
        }
    }

    private async Task MarquerNotificationsCommeLues(string type)
    {
        if (type == "NouvelleIntervention")
        {
            _unreadNotificationCount = 0;
            TechnicienNotificationStateService.MarkNavbarNotificationsAsRead();
        }

        else if (type == "NouvelleDemande")
        {
            _unreadDemandeNotificationCount = 0;
            ResponsableNotificationStateService
                .MarkNouvelleDemandeNotificationsAsRead();
        }

        else if (type == "InterventionTerminee")
        {
            _unreadValidationNotificationCount = 0;
            ResponsableValidationNotificationStateService
                .MarkInterventionTermineeNotificationsAsRead();
        }

        StateHasChanged();

        try
        {
            await TokenProvider.LoadTokenAsync();
            if (!string.IsNullOrWhiteSpace(TokenProvider.Token))
            {
                var client = HttpClientFactory.CreateClient("Api");
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);
                await client.PutAsync($"api/Notifications/read?type={Uri.EscapeDataString(type)}", null);
            }
        }
        catch (Exception)
        {
            // Navigation must continue even if notifications cannot be marked as read.
        }

    }

    public class NotificationDto
    {
        public int Id { get; set; }
        public string Type { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public DateTime DateCreation { get; set; }
        public bool EstLue { get; set; }
        public int? DemandeId { get; set; }
        public int? InterventionId { get; set; }
    }
}
