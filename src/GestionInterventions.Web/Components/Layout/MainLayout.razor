@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using GestionInterventions.Web.Authentication
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="app-topbar">
    <button type="button"
            class="app-sidebar-toggle"
            aria-label="@(_navOpen ? "Fermer le menu" : "Ouvrir le menu")"
            aria-controls="app-sidebar"
            aria-expanded="@_navOpen"
            @onclick="ToggleNav">
        <span></span>
        <span></span>
        <span></span>
    </button>
    <a href="/accueil" class="landing-logo"><img src="/images/siyana-dz-logo.png" alt="Siyana DZ" class="landing-logo-image" /></a>

    <AuthorizeView Context="topbarContext">
        <Authorized>
            <div class="user-menu">
                <span class="user-name">
                    @(topbarContext.User.FindFirst("Nom")?.Value ??
                    topbarContext.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleMenu">⏷</button>

                <div class="user-dropdown @(_menuOuvert ? "show" : "")">
                    <AuthorizeView Roles="Client" Context="dropdownContext">
                        <Authorized>
                            <a href="/modifier-coordonnees">Modifier mes coordonnées</a>
                        </Authorized>
                    </AuthorizeView>
                    <button @onclick="HandleLogout">Se déconnecter</button>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

<div class="app-shell d-flex">
    @if (_navOpen)
    {
        <button type="button"
                class="app-sidebar-backdrop"
                aria-label="Fermer le menu"
                @onclick="CloseNav">
        </button>
    }

    <div id="app-sidebar" class="app-sidebar @(_navOpen ? "is-open" : "")" @onclick="CloseNav">
        <NavMenu />
    </div>

    <main class="app-main flex-grow-1 p-4">
        @Body
    </main>
</div>

@code {
    private bool _menuOuvert;
    private bool _navOpen;

    private void ToggleMenu()
    {
        _menuOuvert = !_menuOuvert;
    }

    private void ToggleNav()
    {
        _navOpen = !_navOpen;
    }

    private void CloseNav()
    {
        _navOpen = false;
    }

    private async Task HandleLogout()
    {
        await AuthStateProvider.MarkUserAsLoggedOutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
