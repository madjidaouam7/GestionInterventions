@using System.Net.Http.Json
@using GestionInterventions.Web.Common.Http
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<div class="auth-form-surface @(InModal ? "auth-register-layout" : "")">
    @if (InModal)
    {
        <aside class="auth-register-brand-panel">
            <span class="auth-form-logo">GI</span>
            <h3>Gestion Interventions</h3>
            <p>Centralisez vos demandes, équipements et interventions dans un espace unique.</p>
        </aside>
    }

    <div class="auth-form-content">
        <EditForm Model="_formModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Nom</label>
                <InputText class="form-control" @bind-Value="_formModel.Nom" />
            </div>

            <div class="mb-3">
                <label>Email</label>
                <InputText class="form-control" @bind-Value="_formModel.Email" />
            </div>

            <div class="mb-3">
                <label>Mot de passe</label>
                <InputText type="password" class="form-control" @bind-Value="_formModel.Password" />
            </div>

            <div class="mb-3">
                <label>Téléphone</label>
                <InputText class="form-control" @bind-Value="_formModel.Telephone" />
            </div>

            <div class="mb-3">
                <label>Adresse</label>
                <InputText class="form-control" @bind-Value="_formModel.Adresse" />
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger">@_errorMessage</div>
            }

            @if (_success)
            {
                <div class="alert alert-success">Compte créé avec succès. Vous pouvez maintenant vous connecter.</div>
            }

            <button type="submit" class="btn btn-primary auth-submit" disabled="@_isSubmitting">
                @(_isSubmitting ? "Création..." : "Créer mon compte")
            </button>
        </EditForm>

        <p class="auth-form-switch">
            Déjà un compte ?
            @if (OnSwitchToLogin.HasDelegate)
            {
                <button type="button" class="btn btn-link auth-switch-link" @onclick="OnSwitchToLogin">
                    Se connecter
                </button>
            }
            else
            {
                <a href="/login">Se connecter</a>
            }
        </p>
    </div>
</div>

@code {
    [Parameter]
    public bool InModal { get; set; }

    [Parameter]
    public EventCallback OnSwitchToLogin { get; set; }

    private readonly FormModel _formModel = new();
    private bool _isSubmitting;
    private string? _errorMessage;
    private bool _success;

    private async Task HandleRegister()
    {
        _isSubmitting = true;
        _errorMessage = null;
        _success = false;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            var response = await client.PostAsJsonAsync("api/Clients", new
            {
                Nom = _formModel.Nom,
                Email = _formModel.Email,
                Password = _formModel.Password,
                Telephone = _formModel.Telephone,
                Adresse = _formModel.Adresse
            });

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await ApiErrorMessageReader.ReadAsync(response, "Erreur lors de l'inscription.");
                return;
            }

            _success = true;

            await Task.Delay(1500);
            Navigation.NavigateTo("/login");
        }
        catch (Exception)
        {
            _errorMessage = "Impossible de contacter le serveur.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class FormModel
    {
        public string Nom { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Telephone { get; set; } = string.Empty;
        public string Adresse { get; set; } = string.Empty;
    }
}