@using System.Net.Http.Json
@using GestionInterventions.Web.Authentication
@inject IHttpClientFactory HttpClientFactory
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="auth-form-surface">
    @if (InModal)
    {
        <div class="auth-form-brand">
            <span class="auth-form-logo">GI</span>
            <span class="auth-form-brand-copy">
                <strong>Gestion Interventions</strong>
                <span>Accédez à votre espace de gestion</span>
            </span>
        </div>
    }

    <EditForm Model="_loginModel" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="_loginModel.Email" />
        </div>

        <div class="mb-3">
            <label>Mot de passe</label>
            <InputText type="password" class="form-control" @bind-Value="_loginModel.Password" />
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        <button type="submit" class="btn btn-primary auth-submit" disabled="@_isLoading">
            @(_isLoading ? "Connexion..." : "Se connecter")
        </button>
    </EditForm>

    <p class="auth-form-switch">
        Pas encore de compte ?
        @if (OnSwitchToRegister.HasDelegate)
        {
            <button type="button" class="btn btn-link auth-switch-link" @onclick="OnSwitchToRegister">
                S'inscrire
            </button>
        }
        else
        {
            <a href="/register">S'inscrire</a>
        }
    </p>
</div>

@code {
    [Parameter]
    public bool InModal { get; set; }

    [Parameter]
    public string? ReturnUrl { get; set; }

    [Parameter]
    public EventCallback OnSwitchToRegister { get; set; }

    private readonly LoginModel _loginModel = new();
    private string? _errorMessage;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(GetReturnUrl(), replace: true);
        }
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            var response = await client.PostAsJsonAsync("api/Auth/login", new
            {
                Email = _loginModel.Email,
                Password = _loginModel.Password
            });

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Email ou mot de passe incorrect.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

            if (result is null || string.IsNullOrWhiteSpace(result.Token))
            {
                _errorMessage = "Réponse invalide du serveur.";
                return;
            }

            await AuthStateProvider.MarkUserAsAuthenticatedAsync(result.Token);
            Navigation.NavigateTo(GetReturnUrl(), forceLoad: false);
        }
        catch (Exception)
        {
            _errorMessage = "Impossible de contacter le serveur.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetReturnUrl()
    {
        return !string.IsNullOrWhiteSpace(ReturnUrl) &&
            ReturnUrl.StartsWith('/') &&
            !ReturnUrl.StartsWith("//", StringComparison.Ordinal)
            ? ReturnUrl
            : "/accueil";
    }

    private sealed class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private sealed class LoginResponse
    {
        public string Token { get; set; } = string.Empty;
    }
}