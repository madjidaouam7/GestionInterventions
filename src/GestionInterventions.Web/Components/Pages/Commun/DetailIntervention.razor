@page "/intervention/{InterventionId:int}"
@attribute [Authorize(Roles = "Client,Technicien,Responsable")]
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using GestionInterventions.Web.Authentication
@inject IHttpClientFactory HttpClientFactory
@inject TokenProvider TokenProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Détail intervention</PageTitle>

<h1>Intervention #@InterventionId</h1>

@if (_isLoading)
{
    <p>Chargement...</p>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}
@if (_intervention is not null)
{
    <Modal Titre="Détails de l'intervention" Visible="true" OnClose="FermerDetails">
        <div class="intervention-details-main">
            <dl class="intervention-details-column">
                <div class="detail-item">
                    <dt>Équipement</dt>
                    <dd>@_intervention.EquipementNom</dd>
                </div>
                <div class="detail-item">
                    <dt>Problème / description</dt>
                    <dd>@_intervention.DescriptionDemande</dd>
                </div>
                <div class="detail-item">
                    <dt>Date prévue</dt>
                    <dd>@_intervention.DatePrevue.ToString("dd/MM/yyyy HH:mm")</dd>
                </div>
            </dl>
            <dl class="intervention-details-column">
                <div class="detail-item">
                    <dt>Intervention ID</dt>
                    <dd>#@_intervention.Id</dd>
                </div>
                <div class="detail-item">
                    <dt>Demande ID</dt>
                    <dd>#@_intervention.DemandeId</dd>
                </div>
                <div class="detail-item">
                    <dt>Statut</dt>
                    <dd><span
                        class="badge @GetStatutBadgeClass(_intervention.Statut)">@GetStatutLabel(_intervention.Statut)</span>
                    </dd>
                </div>
            </dl>
        </div>

        <div class="intervention-details-divider" role="separator"></div>

        <h3 class="intervention-report-title">Compte rendu</h3>
        @if (_intervention.CompteRendu is null)
        {
            <p class="text-muted intervention-report-empty">Aucun compte rendu disponible.</p>
        }
        else
        {
            <dl class="intervention-details intervention-report">
                <div>
                    <dt>Opérations effectuées</dt>
                    <dd>@DisplayOrFallback(_intervention.CompteRendu.OperationsEffectuees)</dd>
                </div>
                <div>
                    <dt>Observations</dt>
                    <dd>@DisplayOrFallback(_intervention.CompteRendu.Observations)</dd>
                </div>
                <div>
                    <dt>Résultat</dt>
                    <dd>@_intervention.CompteRendu.Resultat</dd>
                </div>
                <div>
                    <dt>Recommandations</dt>
                    <dd>@DisplayOrFallback(_intervention.CompteRendu.Recommandations)</dd>
                </div>
            </dl>
        }
    </Modal>
}

@code {
    [Parameter]
    public int InterventionId { get; set; }

    private InterventionDto? _intervention;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.GetAsync($"api/Interventions/{InterventionId}");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await ApiErrorMessageReader.ReadAsync(response, "Impossible de charger l'intervention.");
                return;
            }

            _intervention = await response.Content.ReadFromJsonAsync<InterventionDto>();
        }
        catch (Exception)
        {
            _errorMessage = "Impossible de contacter le serveur.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task FermerDetails()
    {
        await JS.InvokeVoidAsync("history.back");
    }
    
    private static string DisplayOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "Non renseigné" : value;
    private static string GetStatutLabel(string statut) => statut switch
    {
        "Planifiee" => "Planifiée",
        "EnCours" => "En cours",
        "Terminee" => "Terminée",
        "Cloturee" => "Clôturée",
        _ => statut
    };

    private static string GetStatutBadgeClass(string statut) => statut switch
    {
        "Planifiee" => "bg-secondary",
        "EnCours" => "bg-warning text-dark",
        "Terminee" => "bg-info text-dark",
        "Cloturee" => "bg-success",
        _ => "bg-secondary"
    };

    private class InterventionDto
    {
        public int Id { get; set; }
        public DateTime DatePrevue { get; set; }
        public int DemandeId { get; set; }
        public int TechnicienId { get; set; }
        public string TechnicienNom { get; set; } = string.Empty;
        public string EquipementNom { get; set; } = string.Empty;
        public string DescriptionDemande { get; set; } = string.Empty;
        public string Statut { get; set; } = string.Empty;
        public CompteRenduDto? CompteRendu { get; set; }
    }

    private class CompteRenduDto
    {
        public string OperationsEffectuees { get; set; } = string.Empty;
        public string Observations { get; set; } = string.Empty;
        public string Resultat { get; set; } = string.Empty;
        public string? Recommandations { get; set; }
    }
}
