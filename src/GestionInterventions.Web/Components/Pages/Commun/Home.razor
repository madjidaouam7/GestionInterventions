@page "/"

@layout LandingLayout

@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using GestionInterventions.Web.Components.Layout

<PageTitle>GestionInterventions - Gestion des interventions techniques</PageTitle>

<div class="landing-page">

    <!-- =========================
         HERO
         ========================= -->

    <section class="hero-section">

        <div class="hero-content">

            <span class="hero-badge">
                Gestion des interventions techniques
            </span>

            <h1>
                Gérez vos interventions
                <span>simplement et efficacement.</span>
            </h1>

            <p>
                Centralisez vos demandes, équipements, techniciens
                et interventions dans une seule plateforme.
            </p>

            <div class="hero-actions">

                <a href="/register" class="hero-btn-primary">
                    Commencer maintenant
                </a>

                <a href="/#fonctionnalites" class="hero-btn-secondary">
                    Découvrir la plateforme
                </a>

            </div>

            <div class="hero-trust">

                <span>
                    ✓ Demandes centralisées
                </span>

                <span>
                    ✓ Suivi en temps réel
                </span>

                <span>
                    ✓ Gestion des interventions
                </span>

            </div>

        </div>


        <!-- =========================
             APERÇU DE L'APPLICATION
             ========================= -->

        <div class="hero-visual">

            <div class="dashboard-card">

                <div class="dashboard-header">

                    <div>

                        <span class="dashboard-small-title">
                            Tableau de bord
                        </span>

                        <h3>
                            Gestion des interventions
                        </h3>

                    </div>

                    <span class="dashboard-status">
                        ● En ligne
                    </span>

                </div>


                <div class="dashboard-stats">

                    <div class="stat-card">

                        <span>
                            Demandes
                        </span>

                        <strong>
                            24
                        </strong>

                    </div>


                    <div class="stat-card">

                        <span>
                            En cours
                        </span>

                        <strong>
                            08
                        </strong>

                    </div>


                    <div class="stat-card">

                        <span>
                            Terminées
                        </span>

                        <strong>
                            16
                        </strong>

                    </div>

                </div>


                <div class="dashboard-intervention">

                    <div class="intervention-icon">
                        🔧
                    </div>

                    <div class="intervention-info">

                        <strong>
                            Maintenance équipement
                        </strong>

                        <span>
                            Intervention #024
                        </span>

                    </div>

                    <span class="intervention-badge">
                        En cours
                    </span>

                </div>


                <div class="dashboard-intervention">

                    <div class="intervention-icon">
                        ⚙️
                    </div>

                    <div class="intervention-info">

                        <strong>
                            Réparation système
                        </strong>

                        <span>
                            Intervention #023
                        </span>

                    </div>

                    <span class="intervention-badge completed">
                        Terminée
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         FONCTIONNALITÉS
         ========================= -->

    <section id="fonctionnalites" class="landing-section">

        <div class="section-heading">

            <span class="section-badge">
                Fonctionnalités
            </span>

            <h2>
                Tout ce dont vous avez besoin
            </h2>

            <p>
                Une plateforme pensée pour simplifier la gestion
                complète de vos interventions techniques.
            </p>

        </div>


        <div class="features-grid">

            <div class="feature-card">

                <div class="feature-icon">
                    📋
                </div>

                <h3>
                    Gestion des demandes
                </h3>

                <p>
                    Centralisez les demandes d'intervention et
                    suivez leur évolution à chaque étape.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🖥️
                </div>

                <h3>
                    Gestion des équipements
                </h3>

                <p>
                    Gardez une vision claire de vos équipements,
                    de leur état et de leur historique.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    📅
                </div>

                <h3>
                    Planification
                </h3>

                <p>
                    Planifiez les interventions et affectez
                    chaque mission au technicien approprié.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🔧
                </div>

                <h3>
                    Suivi des interventions
                </h3>

                <p>
                    Suivez chaque intervention de sa planification
                    jusqu'à sa clôture.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🔔
                </div>

                <h3>
                    Notifications en temps réel
                </h3>

                <p>
                    Recevez instantanément les informations
                    importantes grâce aux notifications temps réel.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    👥
                </div>

                <h3>
                    Gestion des utilisateurs
                </h3>

                <p>
                    Une organisation adaptée aux clients,
                    responsables et techniciens.
                </p>

            </div>

        </div>

    </section>


    <!-- =========================
         COMMENT ÇA MARCHE
         ========================= -->

    <section id="comment-ca-marche" class="landing-section process-section">

        <div class="section-heading">

            <span class="section-badge">
                Comment ça marche ?
            </span>

            <h2>
                Une intervention, quatre étapes.
            </h2>

            <p>
                Un processus simple et structuré pour suivre
                chaque intervention du début à la fin.
            </p>

        </div>


        <div class="process-grid">

            <div class="process-step">

                <div class="process-number">
                    01
                </div>

                <h3>
                    Déclarer
                </h3>

                <p>
                    Le client signale un problème sur son équipement
                    et crée une demande d'intervention.
                </p>

            </div>


            <div class="process-step">

                <div class="process-number">
                    02
                </div>

                <h3>
                    Planifier
                </h3>

                <p>
                    Le responsable accepte la demande et planifie
                    l'intervention avec un technicien.
                </p>

            </div>


            <div class="process-step">

                <div class="process-number">
                    03
                </div>

                <h3>
                    Intervenir
                </h3>

                <p>
                    Le technicien réalise l'intervention et renseigne
                    son compte rendu.
                </p>

            </div>


            <div class="process-step">

                <div class="process-number">
                    04
                </div>

                <h3>
                    Clôturer
                </h3>

                <p>
                    Le responsable valide l'intervention et clôture
                    définitivement la demande.
                </p>

            </div>

        </div>

    </section>


    <!-- =========================
         POUR QUI ?
         ========================= -->

    <section id="roles" class="landing-section roles-section">

        <div class="section-heading">

            <span class="section-badge">
                Pour qui ?
            </span>

            <h2>
                Une plateforme pour chaque acteur
            </h2>

            <p>
                Chaque utilisateur dispose d'un espace adapté
                à son rôle dans le processus d'intervention.
            </p>

        </div>


        <div class="roles-grid">

            <div class="role-card">

                <div class="role-icon">
                    👤
                </div>

                <h3>
                    Client
                </h3>

                <p>
                    Déclarez vos demandes, consultez vos équipements
                    et suivez l'avancement de vos interventions.
                </p>

            </div>


            <div class="role-card">

                <div class="role-icon">
                    🧑‍💼
                </div>

                <h3>
                    Responsable
                </h3>

                <p>
                    Gérez les demandes, planifiez les interventions
                    et coordonnez les équipes techniques.
                </p>

            </div>


            <div class="role-card">

                <div class="role-icon">
                    🧑‍🔧
                </div>

                <h3>
                    Technicien
                </h3>

                <p>
                    Consultez vos interventions, réalisez vos missions
                    et renseignez les comptes rendus.
                </p>

            </div>

        </div>

    </section>


    <!-- =========================
         À PROPOS
         ========================= -->

    <section id="a-propos" class="landing-section about-section">

        <div class="about-content">

            <span class="section-badge">
                À propos
            </span>

            <h2>
                Une gestion plus simple,
                plus claire et plus réactive.
            </h2>

            <p>
                GestionInterventions centralise l'ensemble du cycle
                d'une intervention technique dans une seule application.
            </p>

            <p>
                De la déclaration d'une panne jusqu'à la clôture de
                l'intervention, chaque acteur dispose des informations
                nécessaires au bon moment.
            </p>

            <a href="/register" class="hero-btn-primary">
                Commencer maintenant
            </a>

        </div>

    </section>


    <!-- =========================
         CTA
         ========================= -->

    <section class="landing-cta">

        <div>

            <span class="cta-small">
                Prêt à commencer ?
            </span>

            <h2>
                Simplifiez la gestion de vos interventions.
            </h2>

            <p>
                Rejoignez GestionInterventions et centralisez
                votre activité technique.
            </p>

        </div>

        <a href="/register" class="cta-button">
            Créer un compte
        </a>

    </section>


    <!-- =========================
         FOOTER
         ========================= -->

    <footer class="landing-footer">

        <div class="footer-brand">

            <a href="/" class="landing-logo">

                <span class="logo-icon">
                    GI
                </span>

                <span>
                    GestionInterventions
                </span>

            </a>

            <p>
                La gestion des interventions techniques,
                simplement.
            </p>

        </div>


        <div class="footer-links">

            <a href="/#fonctionnalites">
                Fonctionnalités
            </a>

            <a href="/#comment-ca-marche">
                Comment ça marche
            </a>

            <a href="/#roles">
                Pour qui ?
            </a>

            <a href="/#a-propos">
                À propos
            </a>

            <a href="/login">
                Connexion
            </a>

        </div>


        <div class="footer-copy">

            © 2026 GestionInterventions.
            Tous droits réservés.

        </div>

    </footer>

</div>