@page "/mes-interventions"
@attribute [Authorize(Roles = "Technicien")]
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using GestionInterventions.Web.Authentication
@inject IHttpClientFactory HttpClientFactory
@inject TokenProvider TokenProvider

<PageTitle>Mes interventions</PageTitle>

<h1>Mes interventions</h1>

@if (_isLoading)
{
    <p>Chargement...</p>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_interventions is null || _interventions.Count == 0)
{
    <p>Vous n'avez aucune intervention assignée.</p>
}
else
{
    @foreach (var intervention in _interventions.OrderBy(i => i.DatePrevue))
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Intervention #@intervention.Id</h5>
                <p class="card-text">
                    Date prévue : @intervention.DatePrevue.ToString("dd/MM/yyyy HH:mm")<br />
                    Statut : <span class="badge @GetStatutBadgeClass(intervention.Statut)">@intervention.Statut</span>
                </p>
                <a href="/intervention/@intervention.Id" class="btn btn-sm btn-outline-secondary ms-2">Voir détails</a>

                @if (_actionError is not null && _actionErrorInterventionId == intervention.Id)
                {
                    <div class="alert alert-danger">@_actionError</div>
                }

                @if (intervention.Statut == "Planifiee")
                {
                    <button class="btn btn-primary" @onclick="() => HandleCommencer(intervention.Id)" disabled="@_isProcessing">
                        Commencer
                    </button>
                }
                else if (intervention.Statut == "EnCours")
                {
                    @if (_interventionEnEditionId == intervention.Id)
                    {
                        <EditForm Model="_compteRenduModel" OnValidSubmit="() => HandleTerminer(intervention.Id)">
                            <DataAnnotationsValidator />

                            <div class="mb-2">
                                <label>Opérations effectuées</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="_compteRenduModel.OperationsEffectuees" />
                            </div>

                            <div class="mb-2">
                                <label>Observations</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="_compteRenduModel.Observations" />
                            </div>

                            <div class="mb-2">
                                <label>Résultat</label>
                                <InputSelect class="form-select" @bind-Value="_compteRenduModel.Resultat">
                                    <option value="Succes">Succès</option>
                                    <option value="Echec">Échec — nouvelle intervention nécessaire</option>
                                </InputSelect>
                            </div>

                            <div class="mb-2">
                                <label>Recommandations (optionnel)</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="_compteRenduModel.Recommandations" />
                            </div>

                            <button type="submit" class="btn btn-success" disabled="@_isProcessing">
                                @(_isProcessing ? "Envoi..." : "Valider la fin d'intervention")
                            </button>
                            <button type="button" class="btn btn-outline-secondary ms-2" @onclick="AnnulerEdition">
                                Annuler
                            </button>
                        </EditForm>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="() => OuvrirCompteRendu(intervention.Id)">
                            Terminer
                        </button>
                    }
                }
                else if (intervention.CompteRendu is not null)
                {
                    <div class="mt-2 small text-muted">
                        Résultat : @intervention.CompteRendu.Resultat
                        @if (!string.IsNullOrWhiteSpace(intervention.CompteRendu.Recommandations))
                        {
                            <br />
                            <text>Recommandations : @intervention.CompteRendu.Recommandations</text>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private List<InterventionDto>? _interventions;
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _isProcessing;

    private int? _interventionEnEditionId;
    private CompteRenduModel _compteRenduModel = new();

    private string? _actionError;
    private int? _actionErrorInterventionId;

    protected override async Task OnInitializedAsync()
    {
        await ChargerInterventions();
    }

    private async Task ChargerInterventions()
    {
        _isLoading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.GetAsync("api/Interventions/mes-interventions");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Impossible de charger vos interventions.";
                return;
            }

            _interventions = await response.Content.ReadFromJsonAsync<List<InterventionDto>>();
        }
        catch (Exception)
        {
            _errorMessage = "Une erreur est survenue lors du chargement.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleCommencer(int interventionId)
    {
        _isProcessing = true;
        _actionError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.PutAsync($"api/Interventions/{interventionId}/commencer", null);

            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                _actionError = $"Erreur : {details}";
                _actionErrorInterventionId = interventionId;
                return;
            }

            await ChargerInterventions();
        }
        catch (Exception)
        {
            _actionError = "Impossible de contacter le serveur.";
            _actionErrorInterventionId = interventionId;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void OuvrirCompteRendu(int interventionId)
    {
        _interventionEnEditionId = interventionId;
        _compteRenduModel = new CompteRenduModel();
    }

    private void AnnulerEdition()
    {
        _interventionEnEditionId = null;
    }

    private async Task HandleTerminer(int interventionId)
    {
        _isProcessing = true;
        _actionError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.PutAsJsonAsync($"api/Interventions/{interventionId}/terminer", new
            {
                OperationsEffectuees = _compteRenduModel.OperationsEffectuees,
                Observations = _compteRenduModel.Observations,
                Resultat = _compteRenduModel.Resultat,
                Recommandations = _compteRenduModel.Recommandations
            });

            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                _actionError = $"Erreur : {details}";
                _actionErrorInterventionId = interventionId;
                return;
            }

            _interventionEnEditionId = null;
            await ChargerInterventions();
        }
        catch (Exception)
        {
            _actionError = "Impossible de contacter le serveur.";
            _actionErrorInterventionId = interventionId;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private static string GetStatutBadgeClass(string statut) => statut switch
    {
        "Planifiee" => "bg-secondary",
        "EnCours" => "bg-warning text-dark",
        "Terminee" => "bg-info text-dark",
        "Cloturee" => "bg-success",
        _ => "bg-secondary"
    };

    private class CompteRenduModel
    {
        public string OperationsEffectuees { get; set; } = string.Empty;
        public string Observations { get; set; } = string.Empty;
        public string Resultat { get; set; } = "Succes";
        public string? Recommandations { get; set; }
    }

    private class InterventionDto
    {
        public int Id { get; set; }
        public DateTime DatePrevue { get; set; }
        public int DemandeId { get; set; }
        public int TechnicienId { get; set; }
        public string TechnicienNom { get; set; } = string.Empty;
        public string Statut { get; set; } = string.Empty;
        public CompteRenduDto? CompteRendu { get; set; }
    }

    private class CompteRenduDto
    {
        public string OperationsEffectuees { get; set; } = string.Empty;
        public string Observations { get; set; } = string.Empty;
        public string Resultat { get; set; } = string.Empty;
        public string? Recommandations { get; set; }
    }
}
