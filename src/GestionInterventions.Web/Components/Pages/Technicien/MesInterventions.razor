@page "/mes-interventions"
@attribute [Authorize(Roles = "Technicien")]
@implements IDisposable
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using GestionInterventions.Application.Common.Models
@using GestionInterventions.Web.Authentication
@using GestionInterventions.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory HttpClientFactory
@inject TokenProvider TokenProvider
@inject TechnicienNotificationStateService TechnicienNotificationStateService

<PageTitle>Mes interventions</PageTitle>

<div class="interventions-header">
    <div>
        <h1>Mes interventions</h1>
        <p class="text-muted mb-0">Gérez les interventions qui vous sont attribuées.</p>
    </div>
</div>

@if (_isLoading)
{
    <p>Chargement...</p>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_interventions is null)
{
    <p>Vous n'avez aucune intervention assignée.</p>
}
else
{
    <div class="intervention-filters" role="group" aria-label="Filtrer les interventions">
        @foreach (var filter in Filters)
        {
            <button type="button" class="btn @(IsActiveFilter(filter.Key) ? "btn-primary" : "btn-outline-secondary")"
                    aria-pressed="@IsActiveFilter(filter.Key)" @onclick="() => SetFilter(filter.Key)">
                @filter.Value (@CountForFilter(filter.Key))
                @if (filter.Key == "Afaire" && TechnicienNotificationStateService.ShowAfaireNotificationBadge)
                {
                    <span class="new-filter-indicator" aria-label="Nouvelles interventions non consultées"></span>
                }
            </button>
        }
    </div>

    var filteredInterventions = GetFilteredInterventions().ToList();
    @if (filteredInterventions.Count == 0)
    {
        <p class="text-muted intervention-empty">Aucune intervention ne correspond à ce filtre.</p>
    }
    else
    {
        <div class="interventions-table-wrapper">
            <table class="table interventions-table">
                <thead>
                    <tr>
                        <th scope="col">Intervention</th>
                        <th scope="col">Équipement</th>
                        <th scope="col">Date prévue</th>
                        <th scope="col">Statut</th>
                        <th scope="col" class="interventions-actions-heading">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var intervention in filteredInterventions.OrderByDescending(i => i.Id))
                    {
                        <tr class="@(EstNouvelleIntervention(intervention.Id) ? "nouvelle-intervention" : "")">
                            <td data-label="Intervention" class="intervention-number">#@intervention.Id</td>
                            <td data-label="Équipement" class="text">@intervention.EquipementNom</td>
                            <td data-label="Date prévue">@intervention.DatePrevue.ToString("dd/MM/yyyy HH:mm")</td>
                            <td data-label="Statut"><span
                                class="badge @GetStatutBadgeClass(intervention.Statut)">@GetStatutLabel(intervention.Statut)</span>
                            </td>
                            <td data-label="Actions" class="interventions-actions">
                                @if (intervention.Statut == "Planifiee")
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="() => HandleCommencer(intervention.Id)"
                                            disabled="@_isProcessing">@(_isProcessing && _processingInterventionId == intervention.Id ? "En cours..." : "Commencer")</button>
                                }
                                else if (intervention.Statut == "EnCours")
                                {
                                    <button class="btn btn-sm btn-success" @onclick="() => OuvrirCompteRendu(intervention.Id)"
                                            disabled="@_isProcessing">Terminer</button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => OuvrirDetails(intervention)">Voir détails</button>

                                @if (EstNouvelleIntervention(intervention.Id))
                                {
                                    <span class="new-intervention-indicator" aria-label="Nouvelle intervention"></span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }
}

@if (_interventionDetails is not null)
{
    <Modal Titre="Détails de l'intervention" Visible="true" OnClose="FermerDetails">
        <div class="intervention-details-main">
            <dl class="intervention-details-column">
                <div class="detail-item">
                    <dt>Équipement</dt>
                    <dd>@_interventionDetails.EquipementNom</dd>
                </div>
                <div class="detail-item">
                    <dt>Problème / description</dt>
                    <dd>@_interventionDetails.DescriptionDemande</dd>
                </div>
                <div class="detail-item">
                    <dt>Date prévue</dt>
                    <dd>@_interventionDetails.DatePrevue.ToString("dd/MM/yyyy HH:mm")</dd>
                </div>
            </dl>
            <dl class="intervention-details-column">
                <div class="detail-item">
                    <dt>Intervention ID</dt>
                    <dd>#@_interventionDetails.Id</dd>
                </div>
                <div class="detail-item">
                    <dt>Demande ID</dt>
                    <dd>#@_interventionDetails.DemandeId</dd>
                </div>
                <div class="detail-item">
                    <dt>Statut</dt>
                    <dd><span
                        class="badge @GetStatutBadgeClass(_interventionDetails.Statut)">@GetStatutLabel(_interventionDetails.Statut)</span>
                    </dd>
                </div>
            </dl>
        </div>

        <div class="intervention-details-divider" role="separator"></div>

        <h3 class="intervention-report-title">Compte rendu</h3>
        @if (_interventionDetails.CompteRendu is null)
        {
            <p class="text-muted intervention-report-empty">Aucun compte rendu disponible.</p>
        }
        else
        {
            <dl class="intervention-details intervention-report">
                <div>
                    <dt>Opérations effectuées</dt>
                    <dd>@DisplayOrFallback(_interventionDetails.CompteRendu.OperationsEffectuees)</dd>
                </div>
                <div>
                    <dt>Observations</dt>
                    <dd>@DisplayOrFallback(_interventionDetails.CompteRendu.Observations)</dd>
                </div>
                <div>
                    <dt>Résultat</dt>
                    <dd>@_interventionDetails.CompteRendu.Resultat</dd>
                </div>
                <div>
                    <dt>Recommandations</dt>
                    <dd>@DisplayOrFallback(_interventionDetails.CompteRendu.Recommandations)</dd>
                </div>
            </dl>
        }
    </Modal>
}

@if (_interventionEnEditionId is not null)
{
    <Modal Titre="Terminer l'intervention" Visible="true" OnClose="AnnulerEdition">
        <EditForm Model="_compteRenduModel" OnValidSubmit="() => HandleTerminer(_interventionEnEditionId.Value)">
            <DataAnnotationsValidator />
            <div class="mb-2"><label>Opérations effectuées</label>
                <InputTextArea class="form-control" rows="3" @bind-Value="_compteRenduModel.OperationsEffectuees" />
            </div>
            <div class="mb-2"><label>Observations</label>
                <InputTextArea class="form-control" rows="2" @bind-Value="_compteRenduModel.Observations" />
            </div>
            <div class="mb-2"><label>Résultat</label>
                <InputSelect class="form-select" @bind-Value="_compteRenduModel.Resultat">
                    <option value="Succes">Succès</option>
                    <option value="Echec">Échec — nouvelle intervention nécessaire</option>
                </InputSelect>
            </div>
            <div class="mb-2"><label>Recommandations (optionnel)</label>
                <InputTextArea class="form-control" rows="2" @bind-Value="_compteRenduModel.Recommandations" />
            </div>
            @if (_actionError is not null && _actionErrorInterventionId == _interventionEnEditionId)
            {
                <div class="alert alert-danger">@_actionError</div>
            }
            <button type="submit" class="btn btn-success" disabled="@_isProcessing">@(_isProcessing ? "Envoi..." : "Valider la fin d'intervention")</button>
            <button type="button" class="btn btn-outline-secondary ms-2" @onclick="AnnulerEdition">Annuler</button>
        </EditForm>
    </Modal>
}

@code {
    private List<InterventionDto>? _interventions;
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _isProcessing;
    private int? _processingInterventionId;
    private string _activeFilter = "Toutes";
    private InterventionDto? _interventionDetails;

    private int? _interventionEnEditionId;
    private CompteRenduModel _compteRenduModel = new();

    private string? _actionError;
    private int? _actionErrorInterventionId;

    [SupplyParameterFromQuery(Name = "filter")]
    public string? Filter { get; set; }

    private static readonly IReadOnlyDictionary<string, string> Filters = new Dictionary<string, string>
    {
        ["Toutes"] = "Toutes",
        ["Afaire"] = "À faire",
        ["EnCours"] = "En cours",
        ["Terminees"] = "Terminées"
    };

    protected override void OnInitialized()
    {
        TechnicienNotificationStateService.OnStateChanged += HandleTechnicienNotificationStateChanged;

        if (Filter == "afaire")
            _activeFilter = "Afaire";
        else if (Filter == "encours")
            _activeFilter = "EnCours";
        else if (Filter == "termine")
            _activeFilter = "Terminees";
        else
            _activeFilter = "Toutes";
    }

    public void Dispose()
    {
        TechnicienNotificationStateService.OnStateChanged -= HandleTechnicienNotificationStateChanged;
        TechnicienNotificationStateService.ClearNewInterventionIds();
    }

    protected override async Task OnInitializedAsync()
    {
        await ChargerInterventions();
    }

    private void HandleTechnicienNotificationStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ChargerInterventions()
    {
        _isLoading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.GetAsync("api/Interventions/mes-interventions");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await ApiErrorMessageReader.ReadAsync(response, "Impossible de charger vos interventions.");
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<List<InterventionDto>>();

            if (result is not null)
            {
                _interventions = result;
            }

        }
        catch (Exception)
        {
            _errorMessage = "Une erreur est survenue lors du chargement.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool EstNouvelleIntervention(int interventionId)
    {
        return TechnicienNotificationStateService.NewInterventionIds
            .Contains(interventionId);
    }

    private async Task HandleCommencer(int interventionId)
    {
        _isProcessing = true;
        _processingInterventionId = interventionId;
        _actionError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.PutAsync($"api/Interventions/{interventionId}/commencer", null);

            if (!response.IsSuccessStatusCode)
            {
                _actionError = await ApiErrorMessageReader.ReadAsync(response, "Impossible de commencer l'intervention.");
                _actionErrorInterventionId = interventionId;
                return;
            }

            TechnicienNotificationStateService.ClearNewInterventionIds();
            await ChargerInterventions();
        }
        catch (Exception)
        {
            _actionError = "Impossible de contacter le serveur.";
            _actionErrorInterventionId = interventionId;
        }
        finally
        {
            _isProcessing = false;
            _processingInterventionId = null;
        }
    }

    private void OuvrirCompteRendu(int interventionId)
    {
        _interventionEnEditionId = interventionId;
        _compteRenduModel = new CompteRenduModel();
    }

    private void AnnulerEdition()
    {
        _interventionEnEditionId = null;
        _actionError = null;
        _actionErrorInterventionId = null;
    }

    private async Task HandleTerminer(int interventionId)
    {
        _isProcessing = true;
        _processingInterventionId = interventionId;
        _actionError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.PutAsJsonAsync($"api/Interventions/{interventionId}/terminer", new
            {
                OperationsEffectuees = _compteRenduModel.OperationsEffectuees,
                Observations = _compteRenduModel.Observations,
                Resultat = _compteRenduModel.Resultat,
                Recommandations = _compteRenduModel.Recommandations
            });

            if (!response.IsSuccessStatusCode)
            {
                _actionError = await ApiErrorMessageReader.ReadAsync(response, "Une erreur est survenue lors de l'ajout.");
                _actionErrorInterventionId = interventionId;
                return;
            }

            _interventionEnEditionId = null;
            TechnicienNotificationStateService.ClearNewInterventionIds();
            await ChargerInterventions();
        }
        catch (Exception)
        {
            _actionError = "Impossible de contacter le serveur.";
            _actionErrorInterventionId = interventionId;
        }
        finally
        {
            _isProcessing = false;
            _processingInterventionId = null;
        }
    }


    private IEnumerable<InterventionDto> GetFilteredInterventions()
    {
        var interventions = _interventions ?? Enumerable.Empty<InterventionDto>();
        var filtered = _activeFilter switch
        {
            "Afaire" => interventions.Where(i => i.Statut == "Planifiee"),
            "EnCours" => interventions.Where(i => i.Statut == "EnCours"),
            "Terminees" => interventions.Where(i => i.Statut is "Terminee" or "Cloturee"),
            _ => interventions
        };

        return filtered.OrderBy(i => i.DatePrevue);
    }

    private int CountForFilter(string filter) => filter switch
    {
        "Afaire" => _interventions?.Count(i => i.Statut == "Planifiee") ?? 0,
        "EnCours" => _interventions?.Count(i => i.Statut == "EnCours") ?? 0,
        "Terminees" => _interventions?.Count(i => i.Statut is "Terminee" or "Cloturee") ?? 0,
        _ => _interventions?.Count ?? 0
    };

    private bool IsActiveFilter(string filter) => _activeFilter == filter;

    private async Task SetFilter(string filter)
    {
        _activeFilter = filter;

        if (filter == "Afaire")
        {
            try
            {
                await TokenProvider.LoadTokenAsync();
                if (!string.IsNullOrWhiteSpace(TokenProvider.Token))
                {
                    var client = HttpClientFactory.CreateClient("Api");
                    client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

                    var response = await client.PutAsync("api/Notifications/read?type=NouvelleIntervention", null);

                    if (response.IsSuccessStatusCode)
                    {
                        TechnicienNotificationStateService.MarkAfaireNotificationsAsRead();
                    }
                }
            }
            catch (Exception)
            {
                // Impossible de marquer les notifications comme lues, mais le comportement visuel reste cohérent.
            }
        }
    }

    private void OuvrirDetails(InterventionDto intervention) => _interventionDetails = intervention;

    private void FermerDetails() => _interventionDetails = null;

    private static string DisplayOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "Non renseigné" : value;

    private static string GetStatutLabel(string statut) => statut switch
    {
        "Planifiee" => "Planifiée",
        "EnCours" => "En cours",
        "Terminee" => "Terminée",
        "Cloturee" => "Clôturée",
        _ => statut
    };

    private static string GetStatutBadgeClass(string statut) => statut switch
    {
        "Planifiee" => "bg-secondary",
        "EnCours" => "bg-warning text-dark",
        "Terminee" => "bg-info text-dark",
        "Cloturee" => "bg-success",
        _ => "bg-secondary"
    };


    private class CompteRenduModel
    {
        public string OperationsEffectuees { get; set; } = string.Empty;
        public string Observations { get; set; } = string.Empty;
        public string Resultat { get; set; } = "Succes";
        public string? Recommandations { get; set; }
    }

    private class NotificationDto
    {
        public int Id { get; set; }
        public string Type { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public DateTime DateCreation { get; set; }
        public bool EstLue { get; set; }
        public int? DemandeId { get; set; }
        public int? InterventionId { get; set; }
    }

    private class InterventionDto
    {
        public int Id { get; set; }
        public DateTime DatePrevue { get; set; }
        public int DemandeId { get; set; }
        public int TechnicienId { get; set; }
        public string TechnicienNom { get; set; } = string.Empty;
        public string EquipementNom { get; set; } = string.Empty;
        public string DescriptionDemande { get; set; } = string.Empty;
        public string Statut { get; set; } = string.Empty;
        public CompteRenduDto? CompteRendu { get; set; }
    }

    private class CompteRenduDto
    {
        public string OperationsEffectuees { get; set; } = string.Empty;
        public string Observations { get; set; } = string.Empty;
        public string Resultat { get; set; } = string.Empty;
        public string? Recommandations { get; set; }
    }

    private class ErrorResponse
    {
        public string Error { get; set; } = string.Empty;
    }

}
