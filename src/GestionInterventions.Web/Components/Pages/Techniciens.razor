@page "/techniciens"
@attribute [Authorize(Roles = "Responsable")]
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using GestionInterventions.Web.Authentication
@inject IHttpClientFactory HttpClientFactory
@inject TokenProvider TokenProvider

<PageTitle>Techniciens</PageTitle>

<h1>Techniciens</h1>

<button class="btn btn-primary mb-3" @onclick="ToggleFormulaire">
    @(_afficherFormulaire ? "Annuler" : "Ajouter un technicien")
</button>

@if (_afficherFormulaire)
{
    <div class="card mb-3">
        <div class="card-body">
            <EditForm Model="_formModel" OnValidSubmit="HandleCreer">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-2">
                    <label>Nom</label>
                    <InputText class="form-control" @bind-Value="_formModel.Nom" />
                </div>

                <div class="mb-2">
                    <label>Email</label>
                    <InputText class="form-control" @bind-Value="_formModel.Email" />
                </div>

                <div class="mb-2">
                    <label>Mot de passe</label>
                    <InputText type="password" class="form-control" @bind-Value="_formModel.Password" />
                </div>

                <div class="mb-2">
                    <label>Téléphone</label>
                    <InputText class="form-control" @bind-Value="_formModel.Telephone" />
                </div>

                <div class="mb-2">
                    <label>Adresse</label>
                    <InputText class="form-control" @bind-Value="_formModel.Adresse" />
                </div>

                @if (!string.IsNullOrEmpty(_createError))
                {
                    <div class="alert alert-danger">@_createError</div>
                }

                <button type="submit" class="btn btn-success" disabled="@_isCreating">
                    @(_isCreating ? "Création..." : "Créer le technicien")
                </button>
            </EditForm>
        </div>
    </div>
}

@if (_isLoading)
{
    <p>Chargement...</p>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_techniciens is null || _techniciens.Count == 0)
{
    <p>Aucun technicien enregistré.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Adresse</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var technicien in _techniciens)
            {
                <tr>
                    <td>@technicien.Nom</td>
                    <td>@technicien.Email</td>
                    <td>@technicien.Telephone</td>
                    <td>@technicien.Adresse</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<TechnicienDto>? _techniciens;
    private bool _isLoading = true;
    private string? _errorMessage;

    private bool _afficherFormulaire;
    private FormModel _formModel = new();
    private bool _isCreating;
    private string? _createError;

    protected override async Task OnInitializedAsync()
    {
        await ChargerTechniciens();
    }

    private async Task ChargerTechniciens()
    {
        _isLoading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.GetAsync("api/Techniciens");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Impossible de charger les techniciens.";
                return;
            }

            _techniciens = await response.Content.ReadFromJsonAsync<List<TechnicienDto>>();
        }
        catch (Exception)
        {
            _errorMessage = "Une erreur est survenue lors du chargement.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleFormulaire()
    {
        _afficherFormulaire = !_afficherFormulaire;
        _createError = null;
        if (_afficherFormulaire)
        {
            _formModel = new FormModel();
        }
    }

    private async Task HandleCreer()
    {
        _isCreating = true;
        _createError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.PostAsJsonAsync("api/Techniciens", new
            {
                Nom = _formModel.Nom,
                Email = _formModel.Email,
                Password = _formModel.Password,
                Telephone = _formModel.Telephone,
                Adresse = _formModel.Adresse
            });

            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();
                _createError = $"Erreur : {details}";
                return;
            }

            _afficherFormulaire = false;
            await ChargerTechniciens();
        }
        catch (Exception)
        {
            _createError = "Impossible de contacter le serveur.";
        }
        finally
        {
            _isCreating = false;
        }
    }

    private class FormModel
    {
        public string Nom { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Telephone { get; set; } = string.Empty;
        public string Adresse { get; set; } = string.Empty;
    }

    private class TechnicienDto
    {
        public int Id { get; set; }
        public string Nom { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Telephone { get; set; } = string.Empty;
        public string Adresse { get; set; } = string.Empty;
    }
}