@page "/mes-equipements"

@attribute [Authorize(Roles = "Client")]
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using GestionInterventions.Application.Common.Models
@using GestionInterventions.Application.DTOs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject GestionInterventions.Web.Authentication.TokenProvider TokenProvider

<PageTitle>Mes équipements</PageTitle>

<h1>Mes équipements</h1>

@if (_successMessage is not null)
{
    <div class="alert alert-success">
        @_successMessage
    </div>
}

<button class="btn btn-primary mb-3" @onclick="ToggleFormulaire">
    @(_afficherFormulaire ? "Annuler" : "Ajouter un équipement")
</button>

<Modal Titre="Ajouter un équipement" Visible="@_afficherFormulaire" OnClose="FermerFormulaire">
    <EditForm Model="_formModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nom</label>
            <InputText class="form-control" @bind-Value="_formModel.Nom" />
        </div>

        <div class="mb-3">
            <label>Numéro de série</label>
            <InputText class="form-control" @bind-Value="_formModel.NumeroSerie" />
        </div>

        <div class="mb-3">
            <label>Description</label>
            <InputTextArea class="form-control" rows="3" @bind-Value="_formModel.Description" />
        </div>

        <div class="mb-3">
            <label>Localisation</label>
            <InputText class="form-control" @bind-Value="_formModel.Localisation" />
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
            @(_isSubmitting ? "Ajout..." : "Ajouter l'équipement")
        </button>
        <button type="button" class="btn btn-outline-secondary ms-2" @onclick="FermerFormulaire">
            Annuler
        </button>
    </EditForm>
</Modal>

<Modal Titre="Photos de l'équipement" Visible="@_afficherPhotos" OnClose="FermerPhotos">

    @if (_equipementSelectionne is not null)
    {
        @if (_equipementSelectionne.Photos.Count > 0)
        {
            <div class="row g-3 mb-4">
                @foreach (var photo in _equipementSelectionne.Photos)
                {
                    <div class="col-md-4">
                        <div class="card">
                            <img src="@GetPhotoUrl(photo.CheminFichier)" class="card-img-top" alt="@photo.NomFichier"
                                 style="height:150px; object-fit:cover; cursor:pointer;" title="Cliquer pour agrandir"
                                 @onclick="() => AgrandirPhoto(photo.CheminFichier)" />
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">
                Aucune photo pour cet équipement.
            </p>
        }
    }

    <hr />

    <p>
        Sélectionnez une photo pour cet équipement.
    </p>

    <InputFile OnChange="SelectionnerFichier" accept=".jpg,.jpeg,.png,.webp" />

</Modal>

@if (_photoAgrandie is not null)
{
    <div class="photo-overlay">
        <div class="photo-toolbar">
            <button class="btn btn-danger" @onclick="FermerPhotoAgrandie">
                ✕
            </button>
        </div>

        <div class="photo-viewer">
            <img src="@_photoAgrandie" alt="Photo agrandie" />
        </div>
    </div>
}

@if (_isLoading)
{
    <p>Chargement...</p>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_equipements is null || _equipements.Count == 0)
{
    <p>Vous n'avez aucun équipement enregistré.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Numéro de série</th>
                <th>Description</th>
                <th>Localisation</th>
                <th>Statut</th>
                <th>Photos</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var equipement in _equipements)
            {
                <tr>
                    <td>@equipement.Nom</td>
                    <td>@equipement.NumeroSerie</td>
                    <td>@equipement.Description</td>
                    <td>@equipement.Localisation</td>
                    <td><span class="badge @GetStatutEquipementBadgeClass(equipement.Statut)">@equipement.Statut</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OuvrirPhotos(equipement.Id)">
                            Photos
                        </button>
                    </td>
                    <td>
                        <a href="/historique-equipement/@equipement.Id" class="btn btn-sm btn-outline-secondary">
                            Historique
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_totalPages > 1)
    {
        <div class="d-flex justify-content-center align-items-center gap-2 mt-4 mb-4">
            <button class="btn btn-outline-primary" @onclick="PagePrecedente" disabled="@(_page == 1)">
                ← Précédente
            </button>

            <button class="btn @(_page == 1 ? "btn-primary" : "btn-outline-primary")" @onclick="() => AllerAPage(1)">
                1
            </button>

            @if (_page > 3)
            {
                <span class="px-1">...</span>
            }

            @for (int i = Math.Max(2, _page - 1); i <= Math.Min(_totalPages - 1, _page + 1); i++)
            {
                var pageNumber = i;

                <button class="btn @(_page == pageNumber ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => AllerAPage(pageNumber)">
                    @pageNumber
                </button>
            }

            @if (_page < _totalPages - 2)
            {
                <span class="px-1">...</span>
            }

            <button class="btn @(_page == _totalPages ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => AllerAPage(_totalPages)">
                @_totalPages
            </button>

            <button class="btn btn-outline-primary" @onclick="PageSuivante" disabled="@(_page == _totalPages)">
                Suivante →
            </button>
        </div>
    }
}

@code {
    private List<EquipementDto>? _equipements;
    private bool _afficherFormulaire;
    private FormModel _formModel = new();
    private bool _isSubmitting;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _successMessage;
    private int _page = 1;
    private const int _pageSize = 5;
    private int _totalPages;
    private bool _afficherPhotos;
    private int _equipementIdSelectionne;
    private EquipementDto? _equipementSelectionne;
    private string? _photoAgrandie;


    private void ToggleFormulaire()
    {
        _afficherFormulaire = !_afficherFormulaire;
        _errorMessage = null;
        if (_afficherFormulaire)
            _formModel = new FormModel();
    }

    private void FermerFormulaire()
    {
        _afficherFormulaire = false;
        _errorMessage = null;
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var clientIdClaim = authState.User.FindFirst("ClientId")?.Value;

            if (clientIdClaim is null || !int.TryParse(clientIdClaim, out var clientId))
            {
                _errorMessage = "Impossible de déterminer votre identifiant client.";
                return;
            }

            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.PostAsJsonAsync("api/Equipements", new
            {
                Nom = _formModel.Nom,
                NumeroSerie = _formModel.NumeroSerie,
                Description = _formModel.Description,
                Localisation = _formModel.Localisation,
                ClientId = clientId
            });

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await ApiErrorMessageReader.ReadAsync(response, "Une erreur est survenue lors de l'ajout.");
                return;
            }

            _successMessage = "Equipement ajouté avec succès.";
            _afficherFormulaire = false;
            await OnInitializedAsync();
            _ = FaireDisparaitreMessageSucces();
        }
        catch (Exception)
        {
            _errorMessage = "Impossible de contacter le serveur.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task FaireDisparaitreMessageSucces()
    {
        await Task.Delay(5000);

        _successMessage = null;

        await InvokeAsync(StateHasChanged);
    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var clientIdClaim = authState.User.FindFirst("ClientId")?.Value;

            if (clientIdClaim is null)
            {
                _errorMessage = "Impossible de déterminer votre identifiant client.";
                return;
            }

            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.GetAsync($"api/Equipements/{clientIdClaim}/equipements?page={_page}&pageSize={_pageSize}");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await ApiErrorMessageReader.ReadAsync(response, "Impossible de charger vos équipements.");
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<PagedResult<EquipementDto>>();

            if (result is not null)
            {
                _equipements = result.Items;
                _totalPages = result.TotalPages;
            }
        }
        catch (Exception)
        {
            _errorMessage = "Une erreur est survenue lors du chargement.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OuvrirPhotos(int equipementId)
    {
        _equipementIdSelectionne = equipementId;
        _afficherPhotos = true;
        _equipementSelectionne = _equipements?
        .FirstOrDefault(e => e.Id == equipementId);
    }

    private string GetPhotoUrl(string cheminFichier)
    {
        return $"http://localhost:5084/{cheminFichier}";
    }

    private void FermerPhotos()
    {
        _afficherPhotos = false;
    }

    private void AgrandirPhoto(string chemin)
    {
        _photoAgrandie = GetPhotoUrl(chemin);
    }

    private void FermerPhotoAgrandie()
    {
        _photoAgrandie = null;
    }

    private async Task SelectionnerFichier(InputFileChangeEventArgs e)
    {
        var fichier = e.File;

        if (fichier is null)
            return;

        _errorMessage = null;
        _successMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("Api");

            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            await using var stream = fichier.OpenReadStream(5 * 1024 * 1024);

            using var contenu = new MultipartFormDataContent();

            using var contenuFichier = new StreamContent(stream);

            contenuFichier.Headers.ContentType = new MediaTypeHeaderValue(fichier.ContentType);

            contenu.Add(contenuFichier, "fichier", fichier.Name);

            var response = await client.PostAsync(
                $"api/Equipements/{_equipementIdSelectionne}/photos",
                contenu);

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await ApiErrorMessageReader.ReadAsync(response, "Impossible d'ajouter la photo.");

                return;
            }

            _successMessage = "Photo ajoutée avec succès.";
            _afficherPhotos = false;

            await InvokeAsync(StateHasChanged);

            _ = FaireDisparaitreMessageSucces();
        }
        catch (IOException)
        {
            _errorMessage = "Le fichier est trop volumineux ou ne peut pas être lu.";
        }
        catch (Exception)
        {
            _errorMessage = "Une erreur est survenue lors de l'envoi de la photo.";
        }
    }

    private async Task PagePrecedente()
    {
        if (_page > 1)
        {
            _page--;
            await ChargerEquipements();
        }
    }

    private async Task PageSuivante()
    {
        if (_page < _totalPages)
        {
            _page++;
            await ChargerEquipements();
        }
    }

    private async Task AllerAPage(int page)
    {
        if (page < 1 || page > _totalPages || page == _page)
            return;

        _page = page;
        await ChargerEquipements();
    }

    private async Task ChargerEquipements()
    {
        await OnInitializedAsync();
    }

    private static string GetStatutEquipementBadgeClass(string statut) => statut switch
    {
        "Fonctionnel" => "bg-success",
        "EnPanne" => "bg-danger",
        "EnMaintenance" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private class EquipementDto
    {
        public int Id { get; set; }
        public string Nom { get; set; } = string.Empty;
        public string NumeroSerie { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Localisation { get; set; } = string.Empty;
        public string Statut { get; set; } = string.Empty;
        public List<EquipementPhotoDto> Photos { get; set; } = new();
    }

    private class EquipementPhotoDto
    {
        public int Id { get; set; }
        public string NomFichier { get; set; } = string.Empty;
        public string CheminFichier { get; set; } = string.Empty;
        public DateTime DateAjout { get; set; }
    }

    private class FormModel
    {
        public string Nom { get; set; } = string.Empty;
        public string NumeroSerie { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Localisation { get; set; } = string.Empty;
    }

    private class ErrorResponse
    {
        public string Error { get; set; } = string.Empty;
    }
}