@page "/mes-demandes"
@attribute [Authorize(Roles = "Client")]
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using GestionInterventions.Application.Common.Models
@using GestionInterventions.Web.Authentication
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpClientFactory HttpClientFactory
@inject TokenProvider TokenProvider

<PageTitle>Mes demandes</PageTitle>

<h1>Mes demandes d'intervention</h1>

<button class="btn btn-primary mb-3" @onclick="ToggleFormulaire">
    @(_afficherFormulaire ? "Annuler" : "Déclarer une demande")
</button>

@if (_isLoadingEquipements)
{
    <p>Chargement de vos équipements...</p>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else if (_equipements is null || _equipements.Count == 0)
{
    <p>Vous n'avez aucun équipement enregistré. Impossible de déclarer une demande.</p>
}
<Modal Titre="Déclarer une demande" Visible="@(_afficherFormulaire && _equipements is { Count: > 0 })"
       OnClose="FermerFormulaire">
    <EditForm Model="_formModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Équipement concerné</label>
            <InputSelect class="form-select" @bind-Value="_formModel.EquipementId">
                <option value="0">-- Sélectionnez un équipement --</option>
                @foreach (var equipement in _equipements ?? [])
                {
                    <option value="@equipement.Id">@equipement.Nom (@equipement.NumeroSerie)</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label>Description du problème</label>
            <InputTextArea class="form-control" rows="4" @bind-Value="_formModel.Description" />
        </div>

        <div class="mb-3">
            <label>Priorité</label>
            <InputSelect class="form-select" @bind-Value="_formModel.Priorite">
                <option value="Normale">Normale</option>
                <option value="Urgente">Urgente</option>
            </InputSelect>
        </div>

        @if (!string.IsNullOrEmpty(_submitError))
        {
            <div class="alert alert-danger">@_submitError</div>
        }

        @if (_submitSuccess)
        {
            <div class="alert alert-success">Demande déclarée avec succès.</div>
        }

        <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
            @(_isSubmitting ? "Envoi..." : "Déclarer la demande")
        </button>
        <button type="button" class="btn btn-outline-secondary ms-2" @onclick="FermerFormulaire">
            Annuler
        </button>
    </EditForm>
</Modal>

@if (_isLoading)
{
    <p>Chargement...</p>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_demandes is null || _demandes.Count == 0)
{
    <p>Vous n'avez déclaré aucune demande pour le moment.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date de soumission</th>
                <th>Équipement</th>
                <th>Description</th>
                <th>Priorité</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var demande in _demandes.OrderByDescending(d => d.DateDemande))
            {
                <tr>
                    <td>@demande.DateDemande.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@demande.EquipementNom</td>
                    <td>@demande.Description</td>
                    <td>
                        <span class="badge @(demande.Priorite == "Urgente" ? "bg-danger" : "bg-secondary")">
                            @demande.Priorite
                        </span>
                    </td>
                    <td>
                        <span class="badge @GetStatutBadgeClass(demande.Statut)">
                            @demande.Statut
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_totalPages > 1)
    {
        <div class="d-flex justify-content-center align-items-center gap-2 mt-4 mb-4">
            <button class="btn btn-outline-primary" @onclick="PagePrecedente" disabled="@(_page == 1)">
                ← Précédente
            </button>

            <button class="btn @(_page == 1 ? "btn-primary" : "btn-outline-primary")" @onclick="() => AllerAPage(1)">
                1
            </button>

            @if (_page > 3)
            {
                <span class="px-1">...</span>
            }

            @for (int i = Math.Max(2, _page - 1); i <= Math.Min(_totalPages - 1, _page + 1); i++)
            {
                var pageNumber = i;

                <button class="btn @(_page == pageNumber ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => AllerAPage(pageNumber)">
                    @pageNumber
                </button>
            }

            @if (_page < _totalPages - 2)
            {
                <span class="px-1">...</span>
            }

            <button class="btn @(_page == _totalPages ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => AllerAPage(_totalPages)">
                @_totalPages
            </button>

            <button class="btn btn-outline-primary" @onclick="PageSuivante" disabled="@(_page == _totalPages)">
                Suivante →
            </button>
        </div>
    }
}

@code {
    private List<DemandeDto>? _demandes;
    private List<EquipementDto>? _equipements;
    private bool _afficherFormulaire;
    private bool _isLoadingEquipements = true;
    private bool _isLoading = true;
    private FormModel _formModel = new();
    private string? _errorMessage;
    private string? _loadError;
    private string? _submitError;
    private bool _submitSuccess;
    private bool _isSubmitting;
    private int _page = 1;
    private const int _pageSize = 10;
    private int _totalPages;


    protected override async Task OnInitializedAsync()
    {
        await ChargerEquipements();
        await ChargerDemandes();
    }

    private void ToggleFormulaire()
    {
        _afficherFormulaire = !_afficherFormulaire;
        _errorMessage = null;
        if (_afficherFormulaire)
            _formModel = new FormModel();
    }

    private void FermerFormulaire()
    {
        _afficherFormulaire = false;
        _submitError = null;
    }


    private async Task ChargerEquipements()
    {
        _isLoadingEquipements = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var clientIdClaim = authState.User.FindFirst("ClientId")?.Value;

            if (clientIdClaim is null)
            {
                _loadError = "Impossible de déterminer votre identifiant client.";
                return;
            }

            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.GetAsync($"api/Equipements/{clientIdClaim}/equipements?page=1&pageSize=100");

            if (!response.IsSuccessStatusCode)
            {
                _loadError = "Impossible de charger vos équipements.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<PagedResult<EquipementDto>>();
            _equipements = result?.Items;
        }
        catch (Exception)
        {
            _loadError = "Une erreur est survenue lors du chargement.";
        }
        finally
        {
            _isLoadingEquipements = false;
        }
    }


    private async Task ChargerDemandes()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.GetAsync($"api/DemandeInterventions/mes-demandes?page={_page}&pageSize={_pageSize}");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await ApiErrorMessageReader.ReadAsync(response, "Impossible de charger vos demandes.");
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<PagedResult<DemandeDto>>();

            if (result is not null)
            {
                _demandes = result.Items;
                _totalPages = result.TotalPages;
            }
        }
        catch (Exception)
        {
            _errorMessage = "Une erreur est survenue lors du chargement.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PagePrecedente()
    {
        if (_page > 1)
        {
            _page--;
            await ChargerDemandes();
        }
    }

    private async Task PageSuivante()
    {
        if (_page < _totalPages)
        {
            _page++;
            await ChargerDemandes();
        }
    }

    private async Task AllerAPage(int page)
    {
        if (page < 1 || page > _totalPages || page == _page)
            return;

        _page = page;
        await ChargerDemandes();
    }



    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _submitError = null;
        _submitSuccess = false;

        try
        {
            if (_formModel.EquipementId == 0)
            {
                _submitError = "Veuillez sélectionner un équipement.";
                return;
            }

            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            var response = await client.PostAsJsonAsync("api/DemandeInterventions", new
            {
                Description = _formModel.Description,
                EquipementId = _formModel.EquipementId,
                Priorite = _formModel.Priorite
            });

            if (!response.IsSuccessStatusCode)
            {
                _submitError = await ApiErrorMessageReader.ReadAsync(response, "Une erreur est survenue lors de l'ajout.");
                return;
            }

            _submitSuccess = true;
            _formModel = new FormModel();
            await ChargerDemandes();
            _afficherFormulaire = false;
        }
        catch (Exception)
        {
            _submitError = "Impossible de contacter le serveur.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }


    private static string GetStatutBadgeClass(string statut) => statut switch
    {
        "EnAttente" => "bg-warning text-dark",
        "Acceptee" => "bg-success",
        "Refusee" => "bg-danger",
        _ => "bg-secondary"
    };

    private class DemandeDto
    {
        public int Id { get; set; }
        public string Description { get; set; } = string.Empty;
        public DateTime DateDemande { get; set; }
        public int EquipementId { get; set; }
        public string EquipementNom { get; set; } = string.Empty;
        public string Priorite { get; set; } = string.Empty;
        public string Statut { get; set; } = string.Empty;
    }

    private class EquipementDto
    {
        public int Id { get; set; }
        public string Nom { get; set; } = string.Empty;
        public string NumeroSerie { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Localisation { get; set; } = string.Empty;
        public string Statut { get; set; } = string.Empty;
    }

    private class FormModel
    {
        public int EquipementId { get; set; }
        public string Description { get; set; } = string.Empty;
        public string Priorite { get; set; } = "Normale";
    }

    private class ErrorResponse
    {
        public string Error { get; set; } = string.Empty;
    }

    private class PagedResult<T>
    {
        public List<T> Items { get; set; } = [];
        public int TotalCount { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalPages { get; set; }
    }
}
